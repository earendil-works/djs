# docs/decisions.md is append-only and every issue adds to its end: merge both sides
# instead of conflicting (0079).
docs/decisions.md merge=union

# Generated files: a merge keeps one side and scripts/regen.sh rewrites them from the
# merged sources (D1791; the drivers are registered by scripts/setup-merge-drivers.sh).
builtins/gen/prelude.js merge=djs-generated
builtins/gen/resume-points.txt merge=djs-generated
js/src/layout.generated.ts merge=djs-generated
crates/djs-core/src/bytecode/intrinsics.rs merge=djs-intrinsics
# The guide's generated diagrams and fully generated reference pages (D2100;
# scripts/regen.sh always rewrites them).
docs/guide/gen/** merge=djs-generated
docs/guide/ref-*.md merge=djs-generated
# Line lists where both sides usually add different lines: keep both. A duplicate or
# stale ratchet entry is harmless (the gate reports stale entries; the next --update
# rewrites the file), and a bad intrinsics.d.ts union fails the gate's bgen check.
builtins/intrinsics.d.ts merge=union
tests/test262/expected-failures.txt merge=union
tests/corpus/expected-failures.txt merge=union
# The builtin registry is append-only (D2371): both sides' appended lines are kept, and
# scripts/regen.sh (`scripts/registry.py merge`) renumbers the merged tail.
tests/builtins/registry.tsv merge=union
